MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=AppName
JWT_SECRET=your_jwt_secret_here
PORT=5000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — comma-separated list of allowed frontend origins
# In production set this to your deployed frontend URL e.g. https://yourapp.com
# Leave unset for local dev (defaults to http://localhost:5173)
CLIENT_URL=http://localhost:5173
